# Headset session 12, launch 1 of 3 (lane R, frame/perf/session-h12/README.md): the measurement. Build
# defaults (sets two refreshes ahead, the rendered poses submitted). The game logs GalaxyFrame's pose check
# every 5 s: how far each shown set's eye poses are from a locate for the time it is shown.
# Routine: menus, then a Time Trial; head turns during the countdown (standing still), then driving.
KARTFRAME_FRAME_LOG=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
