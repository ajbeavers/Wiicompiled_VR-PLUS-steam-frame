# Headset session 19, launch 01 of 2: frames ended 4000 us after the wake-up, as session 16 launch 3 (clean) and
# session 18 launch 1 (right eye doubled). New: every SteamVR compositor frame logged (vrframes.log) beside the
# app's frame log, so a clean and a doubled launch at the same delay can be told apart by phase. Routine as always.
KARTFRAME_END_DELAY_US=4000
KARTFRAME_FRAME_LOG=1
KARTFRAME_VRTIMING_FRAMES=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
