# Headset session 11, one launch (lane P, frame/perf/session-h11/README.md): the default build, logging per
# set the packet and head pose each eye's uniform fill used (XRS lines with XRP fields) and recording both
# panels. Nothing is switched: this launch measures, on the headset's own timing, whether the two eyes of a
# set were ever rendered from different head poses inside the app.
# Routine: menus, then a Time Trial; head turns during the countdown (standing still), then driving.
KARTFRAME_FRAME_LOG=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
