# Headset session 9, launch 3 of 3, optional (lane M, frame/perf/session-h9/README.md; in the race about half the sets miss the one refresh and are shown a refresh late): fixed eye offsets, and each
# set located for the next refresh instead of two ahead (one refresh less pose prediction, one refresh
# less for each set). Same routine as launch 1.
KARTFRAME_EYE_OFFSETS=fixed
KARTFRAME_AHEAD_REFRESHES=1
KARTFRAME_FRAME_LOG=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
