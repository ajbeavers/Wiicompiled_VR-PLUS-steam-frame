# Headset session 9, launch 2 of 3 (lane M, frame/perf/session-h9/README.md): each eye rendered and
# submitted at the head pose with a fixed eye-to-head offset (the median of the first 120 focused
# locates), so gaze-dependent eye positions cannot reach the images. Same routine as launch 1.
KARTFRAME_EYE_OFFSETS=fixed
KARTFRAME_FRAME_LOG=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
