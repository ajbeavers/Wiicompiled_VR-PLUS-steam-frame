# Headset session 20, launch 01 of 3: the frame's end locked to the compositor's grid, just AFTER its update window
# (vsync + update end p95 + 0.3 ms, published by frame/tools/vrtiming.py; about 5.4 ms after the wake-up). Falls
# back to 4000 us after the wake-up while the grid is missing or stale. Every compositor frame logged. Routine as always.
KARTFRAME_END_PHASE=after
KARTFRAME_FRAME_LOG=1
KARTFRAME_VRTIMING_FRAMES=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
