# Headset session 20, launch 02 of 3: the frame's end locked to the compositor's grid, BEFORE its update window
# (vsync + update start p50 - 1.5 ms, about 1.1 ms after the wake-up). Falls back to 4000 us after the wake-up
# while the grid is missing or stale. Every compositor frame logged. Routine as always.
KARTFRAME_END_PHASE=before
KARTFRAME_FRAME_LOG=1
KARTFRAME_VRTIMING_FRAMES=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
