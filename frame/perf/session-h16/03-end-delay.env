# Headset session 16, launch 3: each frame is ended 4 ms after SteamVR's wake-up instead of at once
# (KARTFRAME_END_DELAY_US; the same set is shown, the next set still starts at the wake-up). Sessions 3 and
# 14 had frames ended 4-5 ms late and showed less double image; this tests it without session 14's queue drain.
KARTFRAME_END_DELAY_US=4000
KARTFRAME_FRAME_LOG=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
