# Headset session 10, launch 1 of 2 (lane O, frame/perf/H9.md): everything KartFrame hands SteamVR the way
# GalaxyFrame does (GalaxyFrame was clean on this headset): R8G8B8A8_SRGB eye swapchains (VkFormat 43),
# COLOR_ATTACHMENT|SAMPLED usage, an xrLocateViews for the frame's own time before each xrEndFrame (the
# first three are the build's new defaults) and GalaxyFrame's OpenXR extension list.
# Routine: menus, then a Time Trial; head turns during the countdown (standing still), then driving.
KARTFRAME_XR_EXTENSIONS=galaxy
KARTFRAME_XR_FORMAT=rgba
KARTFRAME_XR_USAGE=galaxy
KARTFRAME_END_LOCATE=1
KARTFRAME_FRAME_LOG=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
