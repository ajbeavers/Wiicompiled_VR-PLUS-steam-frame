# Headset session 10, launch 2 of 2 (lane O, frame/perf/H9.md; only if launch 1 was clean): the eye
# swapchain format alone (R8G8B8A8_SRGB, GalaxyFrame's), everything else KartFrame's old way (usage
# COLOR_ATTACHMENT|TRANSFER_DST, no extra locate, KartFrame's extension list).
# Routine as launch 1.
KARTFRAME_XR_FORMAT=rgba
KARTFRAME_XR_USAGE=kart
KARTFRAME_END_LOCATE=0
