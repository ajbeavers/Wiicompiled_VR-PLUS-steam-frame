# Headset session 14, launch 1 of 2 (lane U, frame/perf/session-h14/README.md): no desktop window swapchain.
# KARTFRAME_HEADLESS=1: aurora never configures or presents its Gamescope WSI swapchain (the 60 Hz present on
# the eyes' queue that neither the clean xrprobe replay nor any mock run has). Everything else as built.
# Routine: menus, then a Time Trial; head turns during the countdown (standing), then while driving.
KARTFRAME_HEADLESS=1
KARTFRAME_FRAME_LOG=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
