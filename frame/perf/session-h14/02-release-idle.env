# Headset session 14, launch 2 of 2 (lane U, frame/perf/session-h14/README.md): desktop window as usual, Dawn's
# queue drained before each set's releases and its xrEndFrame (KARTFRAME_RELEASE=idle), so SteamVR's client
# submissions there wait behind nothing of ours; game.log reports the drain every 10 s ("release idle drain").
# Routine: the same as launch 1.
KARTFRAME_RELEASE=idle
KARTFRAME_FRAME_LOG=1
KARTFRAME_RECORD=raw
KARTFRAME_SESSION_ENV_ONCE=1
