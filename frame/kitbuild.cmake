# First-run build of the translated game against the kit: writes <BUILD>/build.ninja from kit.json
# and the translator's shard lists. Run with the toolchain's own cmake (no other tool is needed):
#
#   cmake -DKIT=<kit> -DWORKSPACE=<dir holding generated/> -DBUILD=<build dir> -DTOOLCHAIN=<root>
#         [-DJOBS=3] -P kitbuild.cmake
#   <toolchain>/bin/ninja -C <build> -j<jobs>      -> <build>/kartframe
#
# kit.json says how each kind of source is compiled and how everything links. Placeholders in it:
# {kit}, {sysroot} (the kit's own sysroot, so host headers are never read), {workspace}. The
# shard lists come from generated/build_shards/shards.cmake (the translator's own manifest).
cmake_minimum_required(VERSION 3.25)

foreach(v KIT WORKSPACE BUILD TOOLCHAIN)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "kitbuild.cmake: -D${v}= is required")
    endif()
endforeach()
if(NOT DEFINED JOBS)
    set(JOBS 3)
endif()
get_filename_component(KIT "${KIT}" ABSOLUTE)
get_filename_component(WORKSPACE "${WORKSPACE}" REALPATH)
get_filename_component(BUILD "${BUILD}" ABSOLUTE)
file(MAKE_DIRECTORY "${BUILD}")

file(READ "${KIT}/kit.json" KJ)
string(JSON KIT_SCHEMA GET "${KJ}" schema)
if(NOT KIT_SCHEMA EQUAL 1)
    message(FATAL_ERROR "kit.json schema ${KIT_SCHEMA} is not supported by this kitbuild.cmake")
endif()

function(kit_sub out text)
    string(REPLACE "{kit}" "${KIT}" t "${text}")
    string(REPLACE "{sysroot}" "${KIT}/sysroot" t "${t}")
    string(REPLACE "{workspace}" "${WORKSPACE}" t "${t}")
    set(${out} "${t}" PARENT_SCOPE)
endfunction()

# One argument for a POSIX shell, with ninja's own `$` escaping on top.
function(sh_quote out text)
    if(text MATCHES "^[A-Za-z0-9_@%+=:,./-]+$")
        set(q "${text}")
    else()
        string(REPLACE "'" "'\\''" q "${text}")
        set(q "'${q}'")
    endif()
    string(REPLACE "$" "$$" q "${q}")
    set(${out} "${q}" PARENT_SCOPE)
endfunction()

function(json_args out)  # <out> <json path...>: a JSON string array as a shell-quoted, substituted string
    string(JSON n LENGTH "${KJ}" ${ARGN})
    set(res "")
    math(EXPR last "${n} - 1")
    if(n GREATER 0)
        foreach(i RANGE ${last})
            string(JSON a GET "${KJ}" ${ARGN} ${i})
            kit_sub(a "${a}")
            sh_quote(a "${a}")
            string(APPEND res " ${a}")
        endforeach()
    endif()
    set(${out} "${res}" PARENT_SCOPE)
endfunction()

# ---- the translator's shard lists, relocated to where this translation actually is ---------------
set(manifest "${WORKSPACE}/generated/build_shards/shards.cmake")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "no translation at ${WORKSPACE}/generated (run setup.sh translate first)")
endif()
file(READ "${manifest}" manifest_text)
if(manifest_text MATCHES "set\\(MKW_TRANSLATED_SHARD_ROOT \"([^\"]+)\"\\)")
    set(recorded_root "${CMAKE_MATCH_1}")
    get_filename_component(real_root "${WORKSPACE}/generated/build_shards" REALPATH)
    if(NOT recorded_root STREQUAL real_root)
        string(REPLACE "${recorded_root}" "${real_root}" manifest_text "${manifest_text}")
    endif()
endif()
file(WRITE "${BUILD}/shards_relocated.cmake" "${manifest_text}")
include("${BUILD}/shards_relocated.cmake")

# ---- the data blob assembly: ELF section syntax and this machine's blob paths (as runtime/cmake/PublicProducts.cmake)
set(blob_in "${WORKSPACE}/generated/data_sections_init_blobs.S")
set(blob_out "${BUILD}/data_sections_init_blobs_elf.S")
if(EXISTS "${blob_in}")
    file(READ "${blob_in}" blob)
    string(REPLACE ".section .rdata,\"dr\"" ".section .rodata,\"a\",@progbits" blob "${blob}")
    string(REGEX REPLACE "\\.incbin \"[^\"]*/data_sections_init_blobs/"
        ".incbin \"${WORKSPACE}/generated/data_sections_init_blobs/" blob "${blob}")
    if(NOT blob MATCHES "\\.note\\.GNU-stack")
        string(APPEND blob "\n.section .note.GNU-stack,\"\",@progbits\n")
    endif()
    file(WRITE "${blob_out}" "${blob}")
endif()

# ---- sources per slot --------------------------------------------------------------------------
function(slot_sources out slot)
    string(JSON n LENGTH "${KJ}" sources ${slot})
    set(res "")
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
        string(JSON entry GET "${KJ}" sources ${slot} ${i})
        if(entry MATCHES "^@(.+)$")
            list(APPEND res ${${CMAKE_MATCH_1}})
        else()
            kit_sub(entry "${entry}")
            if(EXISTS "${entry}")
                list(APPEND res "${entry}")
            else()
                message(FATAL_ERROR "kit source missing: ${entry}")
            endif()
        endif()
    endforeach()
    set(${out} "${res}" PARENT_SCOPE)
endfunction()
slot_sources(SRC_RUNTIME runtime)
slot_sources(SRC_PRODUCT product)
slot_sources(SRC_TRANSLATED translated)
list(LENGTH SRC_PRODUCT n_product)
list(LENGTH SRC_TRANSLATED n_translated)
if(n_translated EQUAL 0 OR n_product EQUAL 0)
    message(FATAL_ERROR "the shard lists are empty (${manifest})")
endif()

# ---- build.ninja ---------------------------------------------------------------------------------
set(cxx "${TOOLCHAIN}/bin/clang++")
set(cc "${TOOLCHAIN}/bin/clang")
set(ninja "# generated by kitbuild.cmake from ${KIT}/kit.json; do not edit\nninja_required_version = 1.10\n")
string(APPEND ninja "pool heavy\n  depth = ${JOBS}\n\n")

# Kinds with at least this many sources get a precompiled mkw_pch.h of their own (it is only valid for
# the compiler and flags that wrote it, so it is made here, never shipped).
set(PCH_MIN_SOURCES 8)

set(all_objects "")
function(add_kind kind sources compiler)
    json_args(flags compile ${kind} flags)
    string(JSON want_pch GET "${KJ}" compile ${kind} pch)
    list(LENGTH sources count)
    set(extra "")
    set(pch_dep "")
    set(out "")
    if(want_pch AND count GREATER_EQUAL PCH_MIN_SOURCES)
        set(pch "${BUILD}/pch/${kind}.pch")
        string(APPEND out "rule pch_${kind}\n  command = ${compiler} ${flags} -x c++-header ${KIT}/include/mkw_pch.h -o $out\n  description = PCH ${kind}\n  pool = heavy\n")
        string(APPEND out "build ${pch}: pch_${kind} ${KIT}/include/mkw_pch.h\n\n")
        set(extra "-include-pch ${pch}")
        set(pch_dep "| ${pch}")
    elseif(want_pch OR kind STREQUAL "runtime")
        set(extra "-include mkw_pch.h")
    endif()
    string(APPEND out "rule cc_${kind}\n  command = ${compiler} ${flags} ${extra} -MD -MF $out.d -o $out -c $in\n  description = ${kind} $in\n  depfile = $out.d\n  deps = gcc\n  pool = heavy\n\n")
    set(objs "")
    set(idx 0)
    foreach(src IN LISTS sources)
        get_filename_component(base "${src}" NAME)
        set(obj "${BUILD}/obj/${kind}/${idx}_${base}.o")
        string(APPEND out "build ${obj}: cc_${kind} ${src} ${pch_dep}\n")
        list(APPEND objs "${obj}")
        math(EXPR idx "${idx} + 1")
    endforeach()
    set(KIND_OBJECTS_${kind} "${objs}" PARENT_SCOPE)
    set(NINJA_${kind} "${out}\n" PARENT_SCOPE)
endfunction()

# asm sources are the blob object only; the .cpp runtime sources are the generated data files
set(runtime_cpp "")
set(runtime_asm "")
foreach(s IN LISTS SRC_RUNTIME)
    if(s MATCHES "\\.S$")
        list(APPEND runtime_asm "${blob_out}")  # the rewritten copy made above
    else()
        list(APPEND runtime_cpp "${s}")
    endif()
endforeach()
add_kind(runtime "${runtime_cpp}" "${cxx}")
add_kind(product "${SRC_PRODUCT}" "${cxx}")
add_kind(translated "${SRC_TRANSLATED}" "${cxx}")
add_kind(asm "${runtime_asm}" "${cc}")
foreach(k runtime product translated asm)
    string(APPEND ninja "${NINJA_${k}}")
endforeach()

# link: kit objects and libraries in the recorded order, the game's objects at their slots
json_args(link_flags link flags)
string(JSON n_inputs LENGTH "${KJ}" link inputs)
math(EXPR last "${n_inputs} - 1")
set(rsp "")
set(kit_files "")
foreach(i RANGE ${last})
    string(JSON in GET "${KJ}" link inputs ${i})
    if(in STREQUAL "{game:runtime}")
        foreach(o ${KIND_OBJECTS_runtime} ${KIND_OBJECTS_asm})
            string(APPEND rsp "${o}\n")
        endforeach()
        set(game_objs ${KIND_OBJECTS_runtime} ${KIND_OBJECTS_asm})
    elseif(in STREQUAL "{game:product}")
        foreach(o ${KIND_OBJECTS_product})
            string(APPEND rsp "${o}\n")
        endforeach()
    elseif(in STREQUAL "{game:translated}")
        string(APPEND rsp "-Wl,--start-lib\n")
        foreach(o ${KIND_OBJECTS_translated})
            string(APPEND rsp "${o}\n")
        endforeach()
        string(APPEND rsp "-Wl,--end-lib\n")
    else()
        kit_sub(in "${in}")
        string(APPEND rsp "${in}\n")
        if(in MATCHES "^/")
            list(APPEND kit_files "${in}")
        endif()
    endif()
endforeach()
# flags go through the response file too (one per line is fine for clang)
string(JSON n_flags LENGTH "${KJ}" link flags)
set(flag_lines "")
math(EXPR lastf "${n_flags} - 1")
foreach(i RANGE ${lastf})
    string(JSON f GET "${KJ}" link flags ${i})
    kit_sub(f "${f}")
    string(APPEND flag_lines "${f}\n")
endforeach()
string(JSON out_name GET "${KJ}" link output)
file(WRITE "${BUILD}/link.rsp" "${flag_lines}-o\n${BUILD}/${out_name}\n${rsp}")
set(all_game ${KIND_OBJECTS_runtime} ${KIND_OBJECTS_asm} ${KIND_OBJECTS_product} ${KIND_OBJECTS_translated})
string(REPLACE ";" " " all_game_s "${all_game}")
string(REPLACE ";" " " kit_files_s "${kit_files}")
string(APPEND ninja "rule link\n  command = ${cxx} @${BUILD}/link.rsp\n  description = LINK ${out_name}\n  pool = console\n\n")
string(APPEND ninja "build ${BUILD}/${out_name}: link ${all_game_s} | ${kit_files_s} ${BUILD}/link.rsp\n\ndefault ${BUILD}/${out_name}\n")
file(WRITE "${BUILD}/build.ninja" "${ninja}")
message(STATUS "kitbuild: ${n_translated} translated + ${n_product} product shards, pool ${JOBS}, ${BUILD}/build.ninja")
